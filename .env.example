# --- Database ---
DATABASE_URL=postgresql://sports:sports@localhost:5432/sports

# --- Cache / Queue (Redis + arq) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
# Cookie name for the auth JWT
AUTH_COOKIE_NAME=sports_token

# --- Sports data API ---
# API-Football key. Two ways to access it (auth headers differ):
#   apisports = direct via dashboard.api-football.com  (default)
#   rapidapi  = subscribed through RapidAPI
SPORTS_API_KEY=
SPORTS_API_PROVIDER=apisports
SPORTS_API_BASE_URL=https://v3.football.api-sports.io

# --- Web Push (VAPID) --- generate with: python backend/scripts/gen_vapid.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# "webpush" (real) or "console" (log notifications — for local dev without a browser)
PUSH_TRANSPORT=webpush

# --- Runtime ---
API_PORT=8000
# How often the poller ticks, in seconds
POLL_INTERVAL_SECONDS=20
# How often to rediscover fixtures for followed teams, in seconds (slow — the
# free API tier has a tight daily request budget)
DISCOVER_INTERVAL_SECONDS=3600
# Upcoming fixtures to pull per team on each discovery pass
FIXTURES_LOOKAHEAD=10
# Comma-separated origins allowed by CORS
CORS_ORIGIN=http://localhost:5173
ENV=development
LOG_LEVEL=INFO

# --- Vercel Cron (serverless deploy only) ---
# Set this in the Vercel project's env vars; Vercel sends it back as
# "Authorization: Bearer <value>" on cron-triggered requests to /api/cron/poll.
CRON_SECRET=

# --- Intelligent polling (Free-plan defaults; normally no overrides needed) ---
# Conservative rolling 24-hour cap, shared across app instances and API routes.
MAX_DAILY_API_REQUESTS=90
# Reserve the final requests for active/near-kickoff fixtures, not discovery/search.
API_PRIORITY_RESERVE=15
LIVE_POLL_INTERVAL_SECONDS=180
PRE_MATCH_WINDOW_MINUTES=15
PRE_MATCH_POLL_INTERVAL_SECONDS=900
EXPECTED_MATCH_MINUTES=120
POST_MATCH_GRACE_MINUTES=30
# Back off unresolved starts/final status; stop recovery after this horizon.
STATUS_RECOVERY_HOURS=6
UNRESOLVED_POLL_INTERVAL_SECONDS=1800
# Default uses only today's and tomorrow's global feeds (no paid next/ids).
FIXTURE_DISCOVERY_DAYS=2
FIXTURE_DISCOVERY_REFRESH_SECONDS=21600
